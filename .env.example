# ============================================
# ChatApp Microservices - Example Environment
# ============================================
# Copy this file to `.env` for local development.
# Fill in the placeholder values before starting services.
# Never commit your real `.env` file or production secrets.

# ============================================
# Shared runtime
# ============================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================
# Shared secrets
# ============================================
# Use long random values in real environments.
JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
INTERNAL_API_TOKEN=replace-with-at-least-32-characters

# ============================================
# Shared URLs
# ============================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://chatapp_mongo_user:change-me@mongo:27017/chatapp_chat_service?authSource=admin
USER_DB_URL=postgres://chatapp_user:change-me@user-db:5432/chatapp_user_service
AUTH_DB_URL=mysql://chatapp_auth_user:change-me@auth-db:3306/chatapp_auth_service

# ============================================
# JWT settings
# ============================================
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# Service ports
# ============================================
# Keep both gateway port keys for now because the gateway service still
# supports the older GATEWAY__PORT name while warning that it is deprecated.
PORT=
GATEWAY_PORT=4000
GATEWAY__PORT=4000
AUTH_SERVICE_PORT=4003
USER_SERVICE_PORT=4001
CHAT_SERVICE_PORT=4002

# ============================================
# Gateway service
# ============================================
AUTH_SERVICE_URL=http://auth-service:4003
USER_SERVICE_URL=http://user-service:4001
CHAT_SERVICE_URL=http://chat-service:4002
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ============================================
# Chat service
# ============================================
CHAT_SOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ============================================
# Messaging / outbox settings
# ============================================
OUTBOX_ENABLED=false
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_LOCK_TIMEOUT_MS=30000
OUTBOX_MAX_ATTEMPTS=10
CONSUMER_DEDUPE_ENABLED=true
CONSUMER_LOCK_TIMEOUT_MS=30000

# ============================================
# RabbitMQ local ports / credentials
# ============================================
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================
# Redis local ports
# ============================================
REDIS_PORT=6379

# ============================================
# Mongo local setup
# ============================================
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=chatapp_mongo_user
MONGO_INITDB_ROOT_PASSWORD=change-me

# ============================================
# Postgres local setup
# ============================================
USER_DB_PORT=5432
USER_DB_NAME=chatapp_user_service
USER_DB_USER=chatapp_user
USER_DB_PASSWORD=change-me

# ============================================
# MySQL local setup
# ============================================
AUTH_DB_PORT=3306
AUTH_DB_NAME=chatapp_auth_service
AUTH_DB_USER=chatapp_auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_ROOT_PASSWORD=change-me
