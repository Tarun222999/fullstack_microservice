{
  "name": "chatapp",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "pnpm  -r --workspace-root=false run build",
    "dev": "pnpm -r --workspace-root=false run dev",
    "lint": "pnpm -r --workspace-root=false run lint",
    "typecheck": "pnpm -r --workspace-root=false --if-present run typecheck",
    "format": "pnpm -r --workspace-root=false run format",
    "format:check": "pnpm -r --workspace-root=false run format:check",
    "format:staged": "lint-staged",
    "prepare": "node -e \"const { existsSync } = require('node:fs'); if (!existsSync('.git')) process.exit(0); import('husky').then((m) => m.default()).catch(() => process.exit(0));\"",
    "test": "pnpm -r --workspace-root=false --if-present run test",
    "test:all": "pnpm -r --workspace-root=false --if-present run test",
    "test:db:user": "pnpm --filter @chatapp/user-service test:db",
    "test:db:auth": "pnpm --filter @chatapp/auth-service test:db",
    "test:db:chat": "pnpm --filter chat-service test:db",
    "test:db:all-local": "pnpm test:db:user && pnpm test:db:auth && pnpm test:db:chat"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "22.x",
    "pnpm": "10.28.1"
  },
  "packageManager": "pnpm@10.28.1",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": "prettier --write"
  }
}
