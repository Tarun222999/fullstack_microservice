{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "paths": {
      "@/*": ["./src/*"],
      "@chatapp/common": ["../../packages/common/src/index.ts"],
      "@chatapp/common/*": ["../../packages/common/src/*"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/common" }
  ]
}
