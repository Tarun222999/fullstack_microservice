{
    "name": "@chatapp/auth-service",
    "version": "1.0.0",
    "description": "",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "tsc --project tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths",
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "lint": "eslint \"src/**/*.ts\"",
        "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:db": "vitest run --config vitest.db.config.ts",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\""
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@chatapp/common": "workspace:*",
        "amqplib": "^0.10.9",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mysql2": "^3.16.2",
        "sequelize": "^6.37.7"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.8",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.5",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "@types/supertest": "^6.0.3",
        "eslint": "^9.0.0",
        "prettier": "^3.0.0",
        "supertest": "^7.2.2",
        "testcontainers": "^10.28.0",
        "tsc-alias": "^1.8.16",
        "tsx": "^4.0.0",
        "typescript": "^5.0.0",
        "vitest": "^3.2.4"
    }
}
